        "%%bash\n",
        "# Install build dependencies\n",
        "apt-get update -qq\n",
        "apt-get install -y -qq build-essential libbz2-dev liblzma-dev zlib1g-dev libcurl4-gnutls-dev libssl-dev\n",
        "\n",
        "# 1. Install fastp directly into /usr/local/bin\n",
        "wget -q http://opengene.org/fastp/fastp.0.23.4 -O /usr/local/bin/fastp\n",
        "chmod a+x /usr/local/bin/fastp\n",
        "\n",
        "# 2. Download, compile, and install the real Falco (smithlabcode) into /usr/local/bin\n",
        "wget -q https://github.com/smithlabcode/falco/releases/download/v1.2.4/falco-1.2.4.tar.gz\n",
        "tar -xzf falco-1.2.4.tar.gz\n",
        "cd falco-1.2.4\n",
        "./configure --prefix=/usr/local && make -j2 && make install\n",
        "cd ..\n",
        "rm -rf falco-1.2.4 falco-1.2.4.tar.gz\n",
        "\n",
        "# 3. Download and install Kraken2 directly into /usr/local/bin\n",
        "wget -q https://github.com/DerrickWood/kraken2/archive/refs/tags/v2.1.3.tar.gz\n",
        "tar -xzf v2.1.3.tar.gz\n",
        "cd kraken2-2.1.3\n",
        "./install_kraken2.sh /usr/local/bin\n",
        "cd ..\n",
        "rm -rf kraken2-2.1.3 v2.1.3.tar.gz\n",
        "\n",
        "# 4. Download, compile, and install Bracken v3.1\n",
        "wget -q https://github.com/jenniferlu717/Bracken/archive/refs/tags/v3.1.tar.gz\n",
        "tar -xzf v3.1.tar.gz\n",
        "\n",
        "# Move the folder to /opt/bracken so its internal src/ scripts stay intact\n",
        "rm -rf /opt/bracken\n",
        "mv Bracken-3.1 /opt/bracken\n",
        "\n",
        "# Run Bracken's internal installer script\n",
        "cd /opt/bracken\n",
        "bash install_bracken.sh\n",
        "cd -\n",
        "\n",
        "# Link the main executables into /usr/local/bin so Bash finds them globally\n",
        "ln -sf /opt/bracken/bracken /usr/local/bin/bracken\n",
        "ln -sf /opt/bracken/bracken-build /usr/local/bin/bracken-build\n",
        "\n",
        "# Clean up the downloaded archive\n",
        "rm -f v3.1.tar.gz\n",
        "\n",
        "\n",
        "# Install Miniforge if it isn't already present\n",
        "if [[ ! -x /content/miniforge/bin/conda ]]; then\n",
        "  wget -q \\\n",
        "    https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh \\\n",
        "    -O /tmp/Miniforge3.sh\n",
        "\n",
        "  bash /tmp/Miniforge3.sh -b -p /content/miniforge\n",
        "  rm /tmp/Miniforge3.sh\n",
        "fi\n",
        "# Create the environment and install the tools into it\n",
        "/content/miniforge/bin/conda create -y \\\n",
        "  -p /content/shovill-env \\\n",
        "  -c conda-forge -c bioconda \\\n",
        "  --strict-channel-priority \\\n",
        "  shovill bandage quast bakta ncbi-amrfinderplus\n",
        "\n",
        "# Make the installed commands available in this cell\n",
        "export PATH=\"/content/shovill-env/bin:$PATH\"\n",
        "export MPLBACKEND=Agg\n",
        "\n",
        "#import trnascan\n",
        "/content/miniforge/bin/conda install -y \\\n",
        "  -p /content/shovill-env \\\n",
        "  -c conda-forge -c bioconda \\\n",
        "  --strict-channel-priority \\\n",
        "  trnascan-se\n",
        "\n",
        "# Import plasmid finder\n",
        "/content/miniforge/bin/conda install -y \\\n",
        "  -p /content/shovill-env \\\n",
        "  -c conda-forge -c bioconda \\\n",
        "  --strict-channel-priority \\\n",
        "  plasmidfinder\n",
        "\n",
        "# Import integron finder\n",
        "/content/miniforge/bin/conda install -y \\\n",
        "  -p /content/shovill-env \\\n",
        "  -c conda-forge -c bioconda \\\n",
        "  --strict-channel-priority \\\n",
        "  integron_finder isescan\n",
        "\n",
        "export PATH=\"/content/shovill-env/bin:$PATH\"\n",
        "command -v tRNAscan-SE\n",
        "tRNAscan-SE --version\n",
        "set -e\n",
        "\n",
        "export PATH=\"/content/shovill-env/bin:$PATH\"\n",
        "export MPLBACKEND=Agg\n",
        "\n",
        "command -v amrfinder\n",
        "amrfinder --version\n",
        "\n",
        "bakta_db download \\\n",
        "  --output /content/bakta-data \\\n",
        "  --type light\n",
        "\n",
        "test -f /content/bakta-data/db-light/version.json\n",
        "du -sh /content/bakta-data/db-light\n",
        "\n",
        "\n",
        "# 4. Clean up the old local bin/ folder so there is no confusion\n",
        "rm -rf bin/\n",
        "\n",
        "# 5. Verify all three are now globally recognized\n",
        "fastp --version\n",
        "falco --version\n",
        "kraken2 --version\n",
        "shovill --version\n",
        "bakta --version\n",
        "amrfinder --version\n"
      ]
