        "\n",
        "# Creates directories for the foward and backwards strand. QC stands for quality control\n",
        "mkdir -p results/qc/foward results/qc/reverse\n",
        "\n",
        "# Runs falco to check for errors or low quality sequences\n",
        "falco -o results/qc/foward data/SRR29021881_1.fastq.gz\n",
        "falco -o results/qc/reverse data/SRR29021881_2.fastq.gz\n",
        "\n",
        "#Creates the folder for running fastp cleaning of the data\n",
        "mkdir -p results/trimmed results/fastp_report\n",
        "\n",
        "# FastTP will clean up and remove any poor quality base pairs\n",
        "\n",
        "# fasttp line by line explaination\n",
        "# Tells which data will be used -i\n",
        "# Tells where to output the data and it's file name (ending in .clean) -o\n",
        "  # Tells the programme to output a html and json report -h & -j\n",
        "  # Filters to remove bases below 30bp -l\n",
        "  # Filters to trim off low quality tails at both ends of the read - cut front and back\n",
        "\n",
        "\n",
        "fastp \\\n",
        "  -i data/SRR29021881_1.fastq.gz \\\n",
        "  -I data/SRR29021881_2.fastq.gz \\\n",
        "  -o results/trimmed/SRR29021881_1.clean.fastq.gz \\\n",
        "  -O results/trimmed/SRR29021881_2.clean.fastq.gz \\\n",
        "  -h results/fastp_report/fastp.html\\\n",
        "  -j results/fastp_report/fastp.json\\\n",
        "  -l 30 \\\n",
        "  --cut_front \\\n",
        "  --cut_tail\n",
        "\n",
        "## Above ends the data cleaning part of the programme\n",
